{
  "name": "dsh-bazi",
  "version": "0.1.6",
  "description": "DeepSeek Harness 八字插件：网站排盘、十二方面批语与人生趋势折线，内置 skill",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": { ".": "./src/plugin.js", "./core": "./src/service.js", "./report": "./src/report.js", "./package.json": "./package.json" },
  "bin": { "dsh-bazi": "./src/cli.js" },
  "files": ["src", "skills", "examples", "scripts", "assets", "screenshots.json", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE", "docs", "cordis.patch.yml"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node src/cli.js --input examples/solar.json --provider local --out reports/example",
    "verify:website": "node scripts/verify-website.js",
    "prepack": "node scripts/check-package.js"
  },
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0-0" },
  "dependencies": { "lunar-javascript": "1.7.8" },
  "keywords": ["dsh", "dsh-plugin", "bazi", "八字", "skill", "deepseek-harness"],
  "repository": { "type": "git", "url": "git+https://github.com/wishprophet/dshbazi.git" },
  "bugs": { "url": "https://github.com/wishprophet/dshbazi/issues" },
  "license": "MIT"
}
